async dbDateConvertToTimeZone(input: any, arrayInput: string[], zonename: string) {
        await CommonHelper.asyncForEach(Object.keys(input), async (inputElement: string) => {
            // Check if the key needs to be decrypted
            if (arrayInput.includes(inputElement)) {
                // console.log("what is type ............", typeof input[inputElement])
                // If the value associated with the key is an array, check each element recursively
                if (Array.isArray(input[inputElement])) {
                    await CommonHelper.asyncForEach(input[inputElement], async (nestedElement: any, index: number) => {

                        if (nestedElement && typeof nestedElement === "object") {
                            await this.dbDateConvertToTimeZone(nestedElement, arrayInput, zonename);
                        } else {
                            input[inputElement][index] = await this.convertToTimeZone(zonename, nestedElement);

                        }
                    });
                } else if (input[inputElement] && typeof input[inputElement] === "object") {
                    await this.dbDateConvertToTimeZone(input[inputElement], arrayInput, zonename);
                } else {
                    input[inputElement] = await this.convertToTimeZone(zonename, input[inputElement]);
                }
            }
        });
    }
